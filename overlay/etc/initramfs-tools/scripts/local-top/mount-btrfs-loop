#!/bin/sh
# Attach rootfs.btrfs (stored on the SD card's FAT partition) to /dev/loop0,
# so that root=/dev/loop0 can be mounted by initramfs-tools.
# The FAT partition is mounted under /run so it is moved into the real root
# together with /run (a leftover mount in the initramfs makes run-init fail).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac

. /scripts/functions

for m in vfat nls_cp437 nls_ascii nls_iso8859-1 loop btrfs; do
    modprobe -q "$m" 2>/dev/null || true
done

mkdir -p /run/sdcard

# Owner of the FAT filesystem (vfat has no permissions of its own, ownership is
# set at mount time). Written by build.sh: the default user gets read/write.
MAGLINUX_SDCARD_UID=1000
MAGLINUX_SDCARD_GID=1000
[ -f /conf/conf.d/maglinux-sdcard ] && . /conf/conf.d/maglinux-sdcard
SDCARD_OPTS="rw,uid=$MAGLINUX_SDCARD_UID,gid=$MAGLINUX_SDCARD_GID,dmask=0022,fmask=0133"

# Wait (up to ~30s) for the SD/USB/IDE device to show up and find rootfs.btrfs
# (or, after an update cut off by a power loss, rootfs.btrfs.new / .old)
found=""
i=0
while [ $i -lt 30 ] && [ -z "$found" ]; do
    for dev in /dev/sd* /dev/mmcblk* /dev/vd* /dev/hd*; do
        [ -b "$dev" ] || continue
        if mount -t vfat -o "$SDCARD_OPTS" "$dev" /run/sdcard 2>/dev/null; then
            if [ -f /run/sdcard/rootfs.btrfs ] || [ -f /run/sdcard/rootfs.btrfs.new ] ||
               [ -f /run/sdcard/rootfs.btrfs.old ]; then
                found="$dev"
                break
            fi
            umount /run/sdcard
        fi
    done
    [ -n "$found" ] && break
    sleep 1
    i=$((i + 1))
done

if [ -z "$found" ]; then
    log_failure_msg "mount-btrfs-loop: rootfs.btrfs not found on any FAT partition"
    exit 0
fi

# First boot on a card larger than the image: grow the FAT partition to the end of
# the card. image.sh sized the FAT tables for FAT_MAX_SIZE, so nothing is moved:
# only the partition size in the MBR and the filesystem size in the boot sector
# change. Each is one 4-byte write, so a power cut can only leave the card
# not (fully) grown, and the next boot finishes the job.
le32_read() { od -An -tu4 -j "$2" -N4 "$1"; }
le16_read() { od -An -tu2 -j "$2" -N2 "$1"; }
u8_read()   { od -An -tu1 -j "$2" -N1 "$1"; }
le32_write() {      # device, byte offset, value
    v=$3
    printf "$(printf '\\%03o\\%03o\\%03o\\%03o' $((v & 255)) $((v >> 8 & 255)) \
        $((v >> 16 & 255)) $((v >> 24 & 255)))" |
        dd of="$1" bs=1 seek="$2" conv=notrunc 2>/dev/null
}
grow_sdcard() {
    name=${found#/dev/}
    sys=/sys/class/block/$name
    [ "$(cat "$sys/partition" 2>/dev/null)" = 1 ] || return 0
    link=$(readlink "$sys")             # .../block/<disk>/<partition>
    link=${link%/*}
    disk=/dev/${link##*/}
    disk_size=$(cat "$sys/../size")     # all sizes in 512-byte sectors
    start=$(cat "$sys/start")
    part_size=$(cat "$sys/size")

    # FAT32 boot sector fields
    [ "$(le16_read "$found" 11)" -eq 512 ] || return 0
    spc=$(u8_read "$found" 13)
    rsvd=$(le16_read "$found" 14)
    nfat=$(u8_read "$found" 16)
    total=$(le32_read "$found" 32)
    fatsz=$(le32_read "$found" 36)
    [ "$total" -le "$part_size" ] || return 0
    # Largest filesystem the FAT tables can address (128 entries per FAT sector)
    max=$((rsvd + nfat * fatsz + (fatsz * 128 - 2) * spc))

    new=$(( (disk_size - start) / 2048 * 2048 ))   # to the end, whole MiB
    [ "$new" -le "$max" ] || new=$((max / 2048 * 2048))
    [ $((new - total)) -gt 131072 ] || return 0    # less than 64 MiB to gain

    log_begin_msg "mount-btrfs-loop: growing $found to $((new / 2048)) MiB"
    umount /run/sdcard
    # MBR partition 1: type FAT32 (LBA), CHS end "beyond 8 GB", size
    printf '\014\376\377\377' | dd of="$disk" bs=1 seek=450 conv=notrunc 2>/dev/null
    le32_write "$disk" 458 "$new"
    # Boot sector + its backup (sector 6): total sectors.
    # FSInfo + its backup (sector 7): free cluster count unknown, so it is recounted.
    for s in 0 6; do le32_write "$found" $((s * 512 + 32)) "$new"; done
    for s in 1 7; do le32_write "$found" $((s * 512 + 488)) 4294967295; done
    sync
    partx -u --nr 1 "$disk" || log_failure_msg "mount-btrfs-loop: partx failed, the new size is used after a reboot"
    log_end_msg
    mount -t vfat -o "$SDCARD_OPTS" "$found" /run/sdcard
}
grow_sdcard

# The image to boot: rootfs.btrfs, or another file in the card's root given with
# maglinux.rootfs=<file> on the kernel command line (the boot menu's "previous
# system" entry: maglinux.rootfs=rootfs.btrfs.old)
ROOTFS=rootfs.btrfs
for arg in $(cat /proc/cmdline); do
    case "$arg" in maglinux.rootfs=*) ROOTFS=${arg#maglinux.rootfs=} ;; esac
done
case "$ROOTFS" in */*|"") ROOTFS=rootfs.btrfs ;; esac
if [ "$ROOTFS" != rootfs.btrfs ] && [ ! -f "/run/sdcard/$ROOTFS" ]; then
    log_failure_msg "mount-btrfs-loop: $ROOTFS not found on the card, booting rootfs.btrfs"
    ROOTFS=rootfs.btrfs
fi

# Update from .new files copied to the card (built by "make update" in build/update/,
# copied to the card's root), applied at boot; results go to rootfs-update.log:
#
# * rootfs.btrfs.new alone: the main system with the same kernel. It must have
#   modules for the running kernel. This boot already uses it.
# * a kernel update: boot/vmlinuz.new with all of boot/initrd.img.new,
#   rescue/initramfs.gz.new, rescue/rescue.sqfs.new and rootfs.btrfs.new (their
#   kernel modules must match). rootfs.btrfs.new must have modules for the new
#   kernel's version. After the renames the device reboots into the new kernel.
#
# Each part becomes <part>.old and <part>.new takes its place (only renames; parts
# without a .new are copied to .old), so .old is always the complete previous set:
# the boot menu's "previous system" and "rescue system, previous kernel" boot it.
# A set that fails a check is renamed to .rejected and the current system boots.
# A power loss in the middle is repaired at the next boot.
D=/run/sdcard
PARTS="boot/vmlinuz boot/initrd.img rescue/initramfs.gz rescue/rescue.sqfs rootfs.btrfs"
update_log() {
    log_success_msg "mount-btrfs-loop: $*"
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$D/rootfs-update.log"
}
reject_update() {
    for p in $PARTS; do
        [ -f "$D/$p.new" ] && mv "$D/$p.new" "$D/$p.rejected"
    done
    sync
    update_log "update REJECTED: $1; the .new files are renamed to .rejected, booting the current system"
}
# Version of a kernel image (bzImage header: "HdrS" at 0x202, version string pointer at 0x20e)
kernel_version() {
    [ "$(dd if="$1" bs=1 skip=514 count=4 2>/dev/null)" = HdrS ] || return 1
    p=$(od -An -tu2 -j 526 -N2 "$1") || return 1
    set -- $(dd if="$1" bs=1 skip=$((p + 512)) count=80 2>/dev/null)
    [ -n "$1" ] && echo "$1"
}
# Does a btrfs image have /lib/modules/<version>?
has_modules() {
    [ "$(dd if="$1" bs=1 skip=65600 count=8 2>/dev/null)" = "_BHRfS_M" ] || return 1
    ok=1
    mkdir -p /run/rootfs-new
    if l=$(losetup -r -f --show "$1" 2>/dev/null); then
        if mount -t btrfs -o ro "$l" /run/rootfs-new 2>/dev/null; then
            [ -d "/run/rootfs-new/lib/modules/$2" ] && ok=0
            umount /run/rootfs-new
        fi
        losetup -d "$l"
    fi
    return $ok
}
update_system() {
    # Repair after a power loss between the renames
    for p in $PARTS; do
        [ -f "$D/$p" ] && continue
        if [ -f "$D/$p.new" ]; then
            mv "$D/$p.new" "$D/$p"; update_log "repaired after an interruption: $p.new -> $p"
        elif [ -f "$D/$p.old" ]; then
            mv "$D/$p.old" "$D/$p"; update_log "repaired: $p missing, restored $p.old -> $p"
        fi
    done
    sync

    new=
    for p in $PARTS; do [ -f "$D/$p.new" ] && new="$new $p"; done
    [ -n "$new" ] || return 0
    log_begin_msg "mount-btrfs-loop: checking the update:$new"
    if [ -f "$D/boot/vmlinuz.new" ]; then
        kernel_update=yes
        for p in $PARTS; do
            [ -s "$D/$p.new" ] || { log_end_msg; reject_update "a kernel update needs all of the set (make update), $p.new is missing"; return 0; }
        done
        kver=$(kernel_version "$D/boot/vmlinuz.new") ||
            { log_end_msg; reject_update "boot/vmlinuz.new is not a kernel image"; return 0; }
        [ "$(dd if="$D/rescue/rescue.sqfs.new" bs=4 count=1 2>/dev/null)" = hsqs ] ||
            { log_end_msg; reject_update "rescue/rescue.sqfs.new is not a squashfs image"; return 0; }
    else
        kernel_update=no
        kver=$(uname -r)
        [ "$new" = " rootfs.btrfs" ] ||
            { log_end_msg; reject_update "without boot/vmlinuz.new only rootfs.btrfs.new can be updated (got:$new); copy the whole set (make update)"; return 0; }
    fi
    has_modules "$D/rootfs.btrfs.new" "$kver" ||
        { log_end_msg; reject_update "rootfs.btrfs.new is not a btrfs image, or has no kernel modules for kernel $kver"; return 0; }
    log_end_msg

    for p in $PARTS; do
        rm -f "$D/$p.old"
        if [ -f "$D/$p.new" ]; then
            mv "$D/$p" "$D/$p.old" && mv "$D/$p.new" "$D/$p"
        else
            cat "$D/$p" > "$D/$p.old.tmp" && mv "$D/$p.old.tmp" "$D/$p.old"
        fi
        sync
    done
    if [ "$kernel_update" = yes ]; then
        update_log "updated: kernel $kver, initrd, rescue system and rootfs.btrfs (the previous set is *.old); rebooting into the new kernel"
        umount /run/sdcard
        reboot
        sleep 30
    fi
    update_log "updated: rootfs.btrfs (the previous set is *.old)"
}
# Not when booting another image (e.g. the previous system): leave the files alone
[ "$ROOTFS" = rootfs.btrfs ] && update_system

[ -b /dev/loop0 ] || mknod /dev/loop0 b 7 0
if losetup /dev/loop0 "/run/sdcard/$ROOTFS"; then
    log_success_msg "mount-btrfs-loop: $found:/$ROOTFS attached to /dev/loop0"
else
    log_failure_msg "mount-btrfs-loop: losetup failed"
fi
