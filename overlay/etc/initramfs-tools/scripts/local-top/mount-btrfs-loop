#!/bin/sh
# Attach rootfs.btrfs (stored on the SD card's FAT partition) to /dev/loop0,
# so that root=/dev/loop0 can be mounted by initramfs-tools.
# The FAT partition is mounted under /run so it is moved into the real root
# together with /run (a leftover mount in the initramfs makes run-init fail).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac

. /scripts/functions

for m in vfat nls_cp437 nls_ascii nls_iso8859-1 loop btrfs; do
    modprobe -q "$m" 2>/dev/null || true
done

mkdir -p /run/sdcard

# Owner of the FAT filesystem (vfat has no permissions of its own, ownership is
# set at mount time). Written by build.sh: the default user gets read/write.
MAGLINUX_SDCARD_UID=1000
MAGLINUX_SDCARD_GID=1000
[ -f /conf/conf.d/maglinux-sdcard ] && . /conf/conf.d/maglinux-sdcard
SDCARD_OPTS="rw,uid=$MAGLINUX_SDCARD_UID,gid=$MAGLINUX_SDCARD_GID,dmask=0022,fmask=0133"

# Wait (up to ~30s) for the SD/USB/IDE device to show up and find rootfs.btrfs
found=""
i=0
while [ $i -lt 30 ] && [ -z "$found" ]; do
    for dev in /dev/sd* /dev/mmcblk* /dev/vd* /dev/hd*; do
        [ -b "$dev" ] || continue
        if mount -t vfat -o "$SDCARD_OPTS" "$dev" /run/sdcard 2>/dev/null; then
            if [ -f /run/sdcard/rootfs.btrfs ]; then
                found="$dev"
                break
            fi
            umount /run/sdcard
        fi
    done
    [ -n "$found" ] && break
    sleep 1
    i=$((i + 1))
done

if [ -z "$found" ]; then
    log_failure_msg "mount-btrfs-loop: rootfs.btrfs not found on any FAT partition"
    exit 0
fi

# First boot on a card larger than the image: grow the FAT partition and its
# filesystem to the end of the card. Only done for partition 1 when more than
# 64 MiB are unused after it, so on later boots this is a no-op.
grow_sdcard() {
    name=${found#/dev/}
    sys=/sys/class/block/$name
    [ "$(cat "$sys/partition" 2>/dev/null)" = 1 ] || return 0
    disk_size=$(cat "$sys/../size")      # the whole card; all in 512-byte sectors
    start=$(cat "$sys/start")
    size=$(cat "$sys/size")
    [ $((disk_size - start - size)) -gt 131072 ] || return 0

    # New size: up to the end of the card, rounded down to 1 MiB. fatresize -s max
    # is not used: it makes the filesystem larger than the partition it writes.
    new_bytes=$(( (disk_size - start) / 2048 * 2048 * 512 ))
    log_begin_msg "mount-btrfs-loop: growing $found to the end of the card"
    umount /run/sdcard
    if fatresize -f -q -n 1 -s "$new_bytes" "$found"; then
        # fatresize overwrites the boot code in the FAT boot sector: reinstall syslinux
        mkdir -p /tmp
        syslinux -i "$found" || log_failure_msg "mount-btrfs-loop: syslinux reinstall FAILED, the card may not boot"
    else
        log_failure_msg "mount-btrfs-loop: fatresize failed"
    fi
    log_end_msg
    mount -t vfat -o "$SDCARD_OPTS" "$found" /run/sdcard
}
grow_sdcard

[ -b /dev/loop0 ] || mknod /dev/loop0 b 7 0
if losetup /dev/loop0 /run/sdcard/rootfs.btrfs; then
    log_success_msg "mount-btrfs-loop: $found:/rootfs.btrfs attached to /dev/loop0"
else
    log_failure_msg "mount-btrfs-loop: losetup failed"
fi
