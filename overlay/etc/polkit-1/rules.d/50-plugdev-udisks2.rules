// Let members of the plugdev group mount, unmount, eject and power off removable
// drives (pendrives) without a password, also from non-local sessions such as SSH
// (no logind seat). System disks still need the admin password.
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.udisks2.filesystem-mount",
        "org.freedesktop.udisks2.filesystem-mount-other-seat",
        "org.freedesktop.udisks2.eject-media",
        "org.freedesktop.udisks2.eject-media-other-seat",
        "org.freedesktop.udisks2.power-off-drive",
        "org.freedesktop.udisks2.power-off-drive-other-seat"
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.isInGroup("plugdev")) {
        return polkit.Result.YES;
    }
});
