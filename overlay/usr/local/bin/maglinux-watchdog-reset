#!/bin/sh
# maglinux-watchdog-reset (wd-reset) - give maglin another full time before the clean
# reboot (maglinux-watchdogd), e.g. after an alarm; for the watchdog group.
FIFO=/run/maglin-wd.fifo
[ -p "$FIFO" ] || { echo "No watchdog service ($FIFO)." >&2; exit 1; }
. /run/maglin-watchdog/state 2>/dev/null
[ "$state" = watching ] || { echo "maglin is not being watched (${state:-unknown})." >&2; exit 1; }
echo RESET > "$FIFO" && echo "Watchdog reset: maglin gets another ${reboot:-?} s before the machine is rebooted."
