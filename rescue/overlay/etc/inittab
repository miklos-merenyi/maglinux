# maglinux rescue: OpenRC + root autologin on the consoles (no password)
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

tty1::respawn:/sbin/getty -n -l /usr/local/bin/autologin 38400 tty1
tty2::respawn:/sbin/getty -n -l /usr/local/bin/autologin 38400 tty2
ttyS0::respawn:/sbin/getty -n -l /usr/local/bin/autologin -L 115200 ttyS0 vt100

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
